// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// AUTH (Auth.js / NextAuth) - login & register

model User {
  id                          String                @id @default(cuid())
  name                        String?
  email                       String?               @unique
  whatsapp                    String?
  emailVerified               DateTime?
  image                       String?
  password                    String? // hash bcrypt, buat login credentials (email/password)
  cart                        Cart?
  orders                      Order[]
  accounts                    Account[]
  sessions                    Session[]
  role                        Role                  @default(USER)
  articles                    Article[]
  comments                    Comment[]
  eventBookings               EventBooking[]
  printableLeads              PrintableLead[]
  recommendationEvents        RecommendationEvent[]
  tableReservations           TableReservation[]
  b2bInquiries                B2BInquiry[]
  inventoryMovements          InventoryMovement[]   @relation("InventoryMovementCreatedBy")
  pointAccount                PointAccount?
  pointTransactions           PointTransaction[]
  vouchers                    UserVoucher[]
  posTransactions             PosTransaction[]      @relation("PosCashier")
  posCustomerTransactions     PosTransaction[]      @relation("PosCustomer")
  playpassTickets             PlaypassTicket[]      @relation("PlaypassCustomer")
  playpassBookings            PlaypassBooking[]
  preOrderReservations        PreOrderReservation[]
  childProfiles               ChildProfile[]
  productReviews              ProductReview[]
  subscriptions               Subscription[]
  issuedPlaypassTickets       PlaypassTicket[]      @relation("PlaypassCashier")
  tableFeeSessions            TableFeeSession[]     @relation("TableFeeCustomer")
  openedTableFeeSessions      TableFeeSession[]     @relation("TableFeeCashier")
  posShifts                   PosShift[]            @relation("PosShiftCashier")
  cashierTransactions         CashierTransaction[]  @relation("CashierTransactionCashier")
  cashierCustomerTransactions CashierTransaction[]  @relation("CashierTransactionCustomer")
  notifications               Notification[]
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String   @db.Text
  href      String?
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model ChildProfile {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  birthDate            DateTime?
  gender               String?
  learningLevel        String?
  learningStyle        String?
  interests            String[]       @default([])
  favoriteThemes       String[]       @default([])
  allergies            String?
  personalizationNotes String?        @db.Text
  isActive             Boolean        @default(true)
  subscriptions        Subscription[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId, isActive])
  @@map("child_profiles")
}

model SubscriptionActivity {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String   @db.Text
  contentType  String
  videoUrl     String?
  guideUrl     String?
  thumbnailUrl String?
  ageMin       Int?
  ageMax       Int?
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@map("subscription_activities")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ============================================
// LANDING PAGE CONTENT
// ============================================

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  logoUrl     String?
  description String?
  address     String?
  phone       String?
  whatsapp    String?
  email       String?
  instagram   String?
  facebook    String?
  tiktok      String?
  youtube     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_profile")
}

model HeroSection {
  id          String      @id @default(cuid())
  headline    String
  subheadline String?
  imageUrl    String?
  ctaText     String?
  ctaLink     String?
  isActive    Boolean     @default(true)
  badges      HeroBadge[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("hero_sections")
}

model HeroBadge {
  id            String      @id @default(cuid())
  label         String
  icon          String?
  order         Int         @default(0)
  heroSectionId String
  heroSection   HeroSection @relation(fields: [heroSectionId], references: [id], onDelete: Cascade)

  @@map("hero_badges")
}

model Statistic {
  id        String   @id @default(cuid())
  label     String
  value     String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("statistics")
}

model PainPoint {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pain_points")
}

model Solution {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("solutions")
}

// "Apa yang Didapatkan Bunda & Si Kecil?"
model Benefit {
  id          String   @id @default(cuid())
  category    String?
  icon        String?
  title       String
  description String?
  imageUrl    String?
  tags        String[]
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}

model HowItWorksStep {
  id          String   @id @default(cuid())
  stepNumber  Int
  title       String
  description String?
  icon        String?
  imageUrl    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("how_it_works_steps")
}

// "Apa Kata Bunda?" - testimoni umum, standalone
model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  role         String?
  avatarUrl    String?
  message      String
  rating       Int?     @default(5)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ============================================
// TAMBAHAN: Role di User (buat bedain admin)
// ============================================
// Di model User yang udah ada, tambahin field ini:
//
//   role Role @default(USER)
//
// Dan tambahin enum baru:

enum Role {
  USER
  ADMIN
  KASIR
}

// ============================================
// BLOG / ARTIKEL
// ============================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  colorTag  String? // buat badge warna: "blue", "purple", "orange", dst
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("article_categories")
}

model Article {
  id                   String           @id @default(cuid())
  title                String
  slug                 String           @unique
  excerpt              String?
  content              String           @db.Text // rich text HTML dari editor
  coverImageUrl        String?
  videoUrl             String?
  videoProvider        String?
  videoDurationSeconds Int?
  isVideoFeatured      Boolean          @default(false)
  status               ArticleStatus    @default(DRAFT)
  publishedAt          DateTime?
  views                Int              @default(0)
  categoryId           String?
  category             ArticleCategory? @relation(fields: [categoryId], references: [id])
  productPlacements    ArticleProductPlacement[]
  authorId             String?
  author               User?            @relation(fields: [authorId], references: [id])
  comments             Comment[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("articles")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  isActive  Boolean  @default(true) // buat moderasi, sembunyiin tanpa hapus permanen
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

// ============================================
// NEWSLETTER (dari section "Jangan Ketinggalan Info Seru!")
// ============================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ============================================
// CATATAN: model User yang udah ada perlu ditambah 2 relasi ini:
//
//   articles Article[]
//   comments Comment[]
//
// (selain field `role Role @default(USER)` yang disebut di atas)
// ============================================

// ============================================
// E-COMMERCE — KATALOG PRODUK (Tahap 1: Catalog + Smart Filter)
// Belum termasuk: Cart, Order, Payment (menyusul di tahap 2)
// ============================================

model ProductCategory {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  imageUrl String? // buat tile "Explore by Category" di homepage
  colorTag String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  // Kategori berjenjang: "Mainan Edukasi" > "Board Games"
  parentId String?
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("product_categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  highlights  String[] // bullet manfaat: "Melatih pengenalan pola dan warna", dst

  price          Int // dalam Rupiah, tanpa desimal
  compareAtPrice Int? // harga coret sebelum diskon, null kalau gak ada diskon

  stock                   Int                      @default(0)
  sku                     String?                  @unique
  cartItems               CartItem[]
  orderItems              OrderItem[]
  posTransactionItems     PosTransactionItem[]
  cashierTransactionItems CashierTransactionItem[]

  // Atribut buat Smart Filter
  ageMin      Int?
  ageMax      Int?
  skillFocus  String[] // "Kognitif", "Motorik", "STEM", "Bahasa", "Sosial"
  playerCount String? // "2-4 Pemain", opsional (khusus board game dkk)

  isBestSeller Boolean @default(false)
  isFeatured   Boolean @default(false) // buat "Trending Now"
  isActive     Boolean @default(true)

  soldCount Int @default(0)

  // Placeholder dulu, gampang di-upgrade ke sistem Review beneran nanti
  // (tinggal tambah model Review terpisah, field ini tetap kepake sebagai cache/fallback)
  ratingAvg   Float @default(0)
  reviewCount Int   @default(0)

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  images               ProductImage[]
  bundleItems          ProductBundleItem[]
  inventoryMovements   InventoryMovement[]
  inventories          ProductInventory[]
  articlePlacements    ArticleProductPlacement[]
  recommendationEvents RecommendationEvent[]
  preOrderCampaign     PreOrderCampaign?
  reviews              ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ArticleProductPlacement {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([articleId, productId])
  @@index([articleId, sortOrder])
  @@index([productId])
  @@map("article_product_placements")
}

enum RecommendationEventType {
  VIEW
  CLICK
  CART
  PURCHASE
}

model RecommendationEvent {
  id        String                  @id @default(cuid())
  userId    String?
  user      User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  productId String
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      RecommendationEventType
  createdAt DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([productId, type, createdAt])
  @@map("recommendation_events")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  isVideo   Boolean @default(false)
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// "Rekomendasi Paket Hemat" - bundle 2+ produk dengan harga spesial
model ProductBundle {
  id          String              @id @default(cuid())
  name        String?
  bundlePrice Int // harga total paket setelah diskon
  isActive    Boolean             @default(true)
  items       ProductBundleItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("product_bundles")
}

model ProductBundleItem {
  id        String        @id @default(cuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Int           @default(0)

  @@map("product_bundle_items")
}

enum PreOrderCampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
  COMPLETED
}

enum PreOrderReservationStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

model PreOrderCampaign {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  title            String
  description      String                 @db.Text
  productId        String                 @unique
  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  price            Int
  preorderOpenAt   DateTime
  preorderCloseAt  DateTime?
  releaseAt        DateTime
  stockLimit       Int?
  reservedQuantity Int                    @default(0)
  status           PreOrderCampaignStatus @default(DRAFT)
  reservations     PreOrderReservation[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, preorderOpenAt, preorderCloseAt])
  @@map("pre_order_campaigns")
}

model PreOrderReservation {
  id                    String                    @id @default(cuid())
  reservationNumber     String                    @unique
  campaignId            String
  campaign              PreOrderCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName          String
  customerEmail         String
  customerWhatsapp      String?
  quantity              Int
  totalPrice            Int
  status                PreOrderReservationStatus @default(PENDING_PAYMENT)
  midtransOrderId       String?                   @unique
  midtransSnapToken     String?
  midtransTransactionId String?
  paidAt                DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([userId, createdAt])
  @@index([campaignId, status])
  @@map("pre_order_reservations")
}

enum SubscriptionPlanInterval {
  MONTHLY
  QUARTERLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum SubscriptionCycleStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  SKIPPED
  CANCELLED
  EXPIRED
}

enum SubscriptionDeliveryStatus {
  SCHEDULED
  PREPARING
  SHIPPED
  DELIVERED
  SKIPPED
  CANCELLED
}

model SubscriptionPlan {
  id            String                   @id @default(cuid())
  slug          String                   @unique
  name          String
  description   String                   @db.Text
  price         Int
  interval      SubscriptionPlanInterval
  isActive      Boolean                  @default(true)
  subscriptions Subscription[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("subscription_plans")
}

model Subscription {
  id                 String                 @id @default(cuid())
  subscriptionNumber String                 @unique
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan       @relation(fields: [planId], references: [id])
  childProfileId     String?
  childProfile       ChildProfile?          @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  status             SubscriptionStatus     @default(PENDING_PAYMENT)
  startDate          DateTime               @default(now())
  nextBillingAt      DateTime
  nextDeliveryAt     DateTime
  pausedUntil        DateTime?
  cancelledAt        DateTime?
  shippingName       String
  shippingPhone      String
  shippingAddress    String                 @db.Text
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  cycles             SubscriptionCycle[]
  deliveries         SubscriptionDelivery[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId, status])
  @@index([status, nextBillingAt])
  @@index([childProfileId])
  @@map("subscriptions")
}

model SubscriptionCycle {
  id                    String                  @id @default(cuid())
  cycleNumber           String                  @unique
  subscriptionId        String
  subscription          Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart           DateTime
  periodEnd             DateTime
  billingDueAt          DateTime
  amount                Int
  status                SubscriptionCycleStatus @default(PENDING_PAYMENT)
  midtransOrderId       String?                 @unique
  midtransSnapToken     String?
  midtransTransactionId String?
  paidAt                DateTime?
  delivery              SubscriptionDelivery?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([subscriptionId, periodStart])
  @@index([status, billingDueAt])
  @@map("subscription_cycles")
}

model SubscriptionDelivery {
  id              String                     @id @default(cuid())
  deliveryNumber  String                     @unique
  subscriptionId  String
  subscription    Subscription               @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cycleId         String                     @unique
  cycle           SubscriptionCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  status          SubscriptionDeliveryStatus @default(SCHEDULED)
  scheduledAt     DateTime
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingNumber  String?
  courier         String?
  fulfillmentNote String?                    @db.Text
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([subscriptionId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("subscription_deliveries")
}

// ============================================
// E-COMMERCE — KERANJANG & CHECKOUT (Tahap 2)
// Payment: Midtrans | Shipping: RajaOngkir (real-time)
// Alamat: input manual tiap checkout (gak ada address book)
// ============================================

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique // 1 user = 1 keranjang aktif
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  bundleId  String? // diisi kalau item ini bagian dari "Paket Hemat" tertentu
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId]) // 1 produk cuma 1 baris per keranjang, quantity yang berubah
  @@map("cart_items")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // format: ORD-20260828-0001
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING_PAYMENT)

  // Alamat pengiriman - input manual tiap checkout, snapshot di sini
  shippingName       String
  shippingPhone      String
  shippingAddress    String @db.Text
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String

  // Ongkir dari RajaOngkir
  shippingCourier String? // "jne", "jnt", dst
  shippingService String? // "REG", "YES", dst
  shippingCost    Int     @default(0)

  subtotal        Int // total harga produk sebelum ongkir
  pointsUsed      Int          @default(0)
  pointsDiscount  Int          @default(0)
  userVoucherId   String?      @unique
  userVoucher     UserVoucher? @relation(fields: [userVoucherId], references: [id])
  trackingNumber  String?
  fulfillmentNote String?      @db.Text
  processingAt    DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  total           Int // subtotal + shippingCost

  // Midtrans
  paymentMethod         String? // "midtrans"
  midtransOrderId       String?   @unique
  midtransTransactionId String?
  midtransSnapToken     String?
  paidAt                DateTime?
  ticketEmailSentAt     DateTime?
  paymentEmailSentAt    DateTime?
  expirationEmailSentAt DateTime?

  items              OrderItem[]
  productReviews     ProductReview[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("orders")
}

enum InventoryMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESERVATION
  RELEASE
  TRANSFER
}

enum InventoryLocation {
  ONLINE_WAREHOUSE
  MARICA_STORE
}

model ProductInventory {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location  InventoryLocation
  quantity  Int               @default(0)
  updatedAt DateTime          @updatedAt

  @@unique([productId, location])
  @@index([location, quantity])
  @@map("product_inventories")
}

model InventoryMovement {
  id               String                @id @default(cuid())
  productId        String?
  product          Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  posTransactionId String?
  posTransaction   PosTransaction?       @relation(fields: [posTransactionId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?                 @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  location         InventoryLocation     @default(ONLINE_WAREHOUSE)
  type             InventoryMovementType
  quantityDelta    Int
  reason           String?
  referenceId      String?
  createdAt        DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([posTransactionId])
  @@index([type, createdAt])
  @@index([location, createdAt])
  @@map("inventory_movements")
}

